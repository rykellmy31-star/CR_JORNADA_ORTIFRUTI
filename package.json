{
  "name": "cr-jornada-hortifruti",
  "version": "1.0.0",
  "private": true,
  "description": "Plataforma SaaS multiempresas de vendas online para Hortifrutis e Verdurões — CR Jornada",
  "type": "module",
  "scripts": {
    "dev": "tsx src/server/dev-entry.ts",
    "dev:vite": "vite --host 0.0.0.0 --port 5173",
    "build:web": "vite build",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx src/server/node-entry.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply cr-jornada-hortifruti-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply cr-jornada-hortifruti-db --remote",
    "cf:dev": "npm run build:web && wrangler dev",
    "cf:deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.9",
    "hono": "^4.7.4",
    "lucide-react": "^0.475.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261119.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^20.17.19",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "better-sqlite3": "^11.8.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^4.1.12",
    "wrangler": "^4.165.0"
  }
}
