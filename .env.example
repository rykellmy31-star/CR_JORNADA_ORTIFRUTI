# Copie para .env apenas no ambiente local. Nunca comite valores reais.
PORT=8787
APP_ENV=development
DATABASE_PATH=data/local.sqlite
PUBLIC_APP_URL=http://localhost:8787

# Use valores aleatórios locais; a produção deve usar Wrangler/GitHub Secrets.
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES
CRM_API_KEY=REPLACE_WITH_RANDOM_CRM_API_KEY
BOOTSTRAP_SECRET=

# Seed apenas no Node local/development. Não habilite seed demonstrativo em produção.
SEED_SUPERADMIN_EMAIL=admin@crjornada.com.br
SEED_DEMO_PASSWORD=CRJornada!Local2026

# Omitidos para homologação local. Para envio real, configure a Evolution API v2.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_TOKEN=
